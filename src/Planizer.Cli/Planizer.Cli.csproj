<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Planizer.Cli</RootNamespace>
    <!--
      Without this the generated runtimeconfig rolls forward only within the target major, so the
      tool refuses to start on a machine that has a newer runtime but not this exact one. A linter
      installed on build agents must run on whatever .NET is already there.
    -->
    <RollForward>LatestMajor</RollForward>
  </PropertyGroup>

  <PropertyGroup>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>planizer</ToolCommandName>
    <PackageId>Planizer</PackageId>
    <PackageOutputPath>nupkg</PackageOutputPath>
    <Description>SQL Server / T-SQL migration linter. Validates and explains DDL/migration scripts before they run: lock level (Sch-M), rewrite vs metadata-only, reversibility. Deterministic rules, offline analysis, no LLM.</Description>
    <Authors>Mustafa Basaran</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>sql-server;mssql;tsql;t-sql;sql;migration;migrations;ddl;linter;lint;analyzer;static-analysis;sarif;dba;ci;azure-sql</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned: 2.0.0-beta5+ broke the API surface this CLI is written against. -->
    <PackageReference Include="System.CommandLine" Version="2.0.0-beta4.22272.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Planizer.Core\Planizer.Core.csproj" />
    <ProjectReference Include="..\Planizer.MsSql\Planizer.MsSql.csproj" />
  </ItemGroup>

</Project>
