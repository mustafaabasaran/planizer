<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Trim/AOT analyzers on every build: with TreatWarningsAsErrors this makes new
         reflection use a compile error instead of a silently broken native binary. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Planizer.Core\Planizer.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SqlServer.TransactSql.ScriptDom" Version="180.78.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Catalog\mssql-ddl-behavior.csv" />
    <EmbeddedResource Include="Catalog\mssql-feature-versions.csv" />
  </ItemGroup>

</Project>
