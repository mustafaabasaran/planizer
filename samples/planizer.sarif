      "results": [
        {
          "ruleId": "MSSQL-BATCH-001",
          "ruleIndex": 0,
          "level": "error",
          "message": {
            "text": "This statement references column dbo.Orders.PaymentTypeId (added at line 25) in the same batch; a batch is compiled as a whole before any statement in it runs, so the column does not exist yet at compile time and the batch fails with error 207 (Invalid column name 'PaymentTypeId').\n\nFix: Put GO after line 25 so this statement compiles in a later batch; where GO is not available, run it as dynamic SQL so it compiles after the ALTER: EXEC sp_executesql N'UPDATE dbo.Orders SET PaymentTypeId = 1 WHERE PaidAt IS NOT NULL;';"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "samples/005_bad_batching.sql",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 27,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "Blocker",
            "inconclusive": false,
            "assumption": "SQL Server 2019, Standard edition, offline mode",
            "statement": "UPDATE dbo.Orders SET PaymentTypeId = 1 WHERE PaidAt IS NOT NULL;"
          }
        },
        {
          "ruleId": "MSSQL-BATCH-002",
          "ruleIndex": 1,
          "level": "error",
          "message": {
            "text": "@now is used here but was declared at line 10 in an earlier batch; GO ends the scope of every variable, so this batch fails to compile with error 137 (Must declare the scalar variable \"@now\").\n\nFix: Re-declare in this batch, before the first use:\nDECLARE @now datetime2(3) = SYSUTCDATETIME();"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "samples/005_bad_batching.sql",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 32,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "Blocker",
            "inconclusive": false,
            "assumption": "SQL Server 2019, Standard edition, offline mode",
            "statement": "UPDATE o SET o.PaymentTypeId = l.PaymentTypeId FROM dbo.Orders AS o JOIN [LegacyDb].dbo.LegacyPaymentMap AS l ON l.Order"
          }
        },
        {
          "ruleId": "MSSQL-ENV-001",
          "ruleIndex": 3,
          "level": "note",
          "message": {
            "text": "USE Orders pins the script to a database name: the migration runner already connects to the target database, and on an environment where the name differs the script fails or runs against the wrong database.\n\nFix: Remove the USE statement and let the runner's connection choose the database."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "samples/005_bad_batching.sql",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 7,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "Info",
            "inconclusive": false,
            "assumption": "SQL Server 2019, Standard edition, offline mode",
            "statement": "USE [Orders];"
          }
        },
        {
          "ruleId": "MSSQL-ENV-002",
          "ruleIndex": 4,
          "level": "note",
          "message": {
            "text": "1 statement in this file references 1 other database by name (LegacyDb), e.g. LegacyDb.dbo.LegacyPaymentMap: the script only runs where that database exists under exactly that name.\n\nFix: Reference other databases through synonyms created per environment (CREATE SYNONYM dbo.X FOR [OtherDb].dbo.X), or move the dependency out of the migration."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "samples/005_bad_batching.sql",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
                  "startLine": 32,
                  "startColumn": 1
                }
              }
            }
          ],
          "properties": {
            "severity": "Info",
